# This file supports comments.
# To add a comment, place the '#' symbol at the beginning of the line.

# Each line represents an independent entry.
# Entries follow the format: Key = {StartRow}, {StartCol}, {Depth}, "Value"
# Key is bound to related calls in the program and is not recommended to modify.
# {StartRow} is a size_t value specifying the starting row.
# {StartCol} is a size_t value specifying the starting column.
# {Depth} is an int value specifying the depth of this component.
# "Value" represents the content displayed by the component. The double quotes on both sides are not included in the value.
# To insert double quotes in Value, use the escape character \".
# Similarly, Value supports common escape characters and also supports ANSI escape sequences using \033 and \x1b.

# Value supports a DSL that uses \sd to insert a pause during output.
# In this syntax, d is an integer in the range [0, 9] that specifies the pause duration in seconds.
# For example, \s3 pauses output for 3 seconds at that point.

# Additionally, any "{}" placeholders found in Value are replaced by the program with the corresponding variable values at output time.
# This substitution is implemented via std::vformat; interested readers are encouraged to refer to relevant documents.

# Below are title bar layout settings.

# The \033[2J\033[H in the Title field below uses screen clearing to update the theme.
# The "Title" entry serves as the title and will be displayed at the top of most interfaces.
Title = 0, 0, 0, "\x1b[40m\x1b[37m\033[2J\033[HConsoleMaze: A simple console maze game.\n----------------------------------------"

# End of title bar layout settings.

# Below are main menu layout settings.

# The "MainMenu" entry is the content of the game main menu.
# The "RetryIntForMainMenu" entry appears in the main menu when the user input does not meet the required conditions; please refer to the original text for details.
MainMenu = 2, 0, 0, "Enter 1 to start the game.\nEnter 2 to edit levels.\nEnter 3 to change language and theme.\nEnter 4 to exit the game.\n>>> "
RetryIntForMainMenu = 6, 0, 1, "\x1b[91mError: Please enter an integer from {} to {}.\x1b[37m\s3"

# End of main menu layout settings.

# Below are "Start The Game" layout settings.

# The "SelectLevel" entry appears before starting the game and is responsible for displaying the user interface for level selection logic.
# The "RetryMenuForSelectLevel" entry appears in the level selection menu when the user input does not meet the required conditions; please refer to the original text for details.
SelectLevel = 2, 0, 0, "Currently at level {}. Press Enter to start the current level, or enter a number from {} to {} to select a level.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForSelectLevel = 4, 0, 1, "\x1b[91mError: Please enter an integer from {} to {}, press Enter, or enter \"exit\".\x1b[37m\s3"

# The "CurrentLevel" entry is the title during the game session.
# The "WinWithoutRecord" entry appears when the player successfully clears the level but does not break the record.
# The "WinWithRecord" entry appears when the player successfully clears the level and breaks the record.
CurrentLevel = 0, 0, 0, "Currently at level {}. Press q to quit the current level.\n---------------------------------------------------------"
WinWithoutRecord = 2, 0, 0, "Congratulations on completing level {}!\nTime: {} seconds {} milliseconds.\s3"
WinWithRecord = 2, 0, 0, "Congratulations on completing level {}!\nTime: {} seconds {} milliseconds.\n\x1b[96mNew record!\x1b[37m\s3"

# End of "Start The Game" layout settings.

# Below are "Edit Levels" layout settings.

# The "EditMenu" entry is the interface for selecting a level to edit.
# The "RetryMenuForEditMenu" entry appears in the selection menu when the user input does not meet the required conditions; please refer to the original text for details.
EditMenu = 2, 0, 0, "There are {} levels available. Enter a number from {} to {} to select a level to edit.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForEditMenu = 4, 0, 1, "\x1b[91mError: Please enter an integer from {} to {}, or enter \"exit\".\x1b[37m\s3"

# The "CreateHint" entry is the interface displayed before creating a new level.
# The "RetryCreateHint" entry appears in the create new level menu when the user input does not meet the required conditions; please refer to the original text for details.
# The "CreateAcception" entry appears after a new level is successfully created.
# The "CreateRejection" entry informs the user that a new level cannot be created; please refer to the original text for details.
# The "EditHintForCreate" entry informs the user how to edit the level; please refer to the original text for details.
CreateHint = 2, 0, 0, "Selected level {} does not exist.\nPress Enter or enter \"create\" to create and edit this level.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryCreateHint = 6, 0, 0, "\x1b[91mError: Please enter \"create\", press Enter, or enter \"exit\".\x1b[37m\s3"
CreateAcception = 2, 0, 0, "Level {} has been created."
CreateRejection = 6, 0, 0, "\x1b[91mError: You can only create the level immediately after the last existing level.\x1b[37m\s3"
EditHintForCreate = 3, 0, 0, "Selected level {}.\nA text editor window will open.\x1b[93mPlease close the text editor window before continuing.\x1b[37m\nIt is strongly recommended to use a monospaced font for editing.\s3"

# The "EditOrDeleteHint" entry is the interface displayed before editing an existing level.
# The "RetryEditOrDeleteHint" entry appears in the edit existing level menu when the user input does not meet the required conditions; please refer to the original text for details.
EditOrDeleteHint = 2, 0, 0, "Selected level {}.\nPress Enter or enter \"edit\" to edit this level.\n\x1b[91mEnter \"delete\" to delete this level. Note: This action cannot be undone!\x1b[37m\nEnter \"exit\" to return to the main menu.\n>>> "
RetryEditOrDeleteHint = 6, 0, 0, "\x1b[91mError: Please enter \"delete\", \"edit\", press Enter, or enter \"exit\".\x1b[37m\s3"

# The "DeleteAcception" entry appears after a level is successfully deleted.
# The "DeleteRejection" entry informs the user that the level cannot be deleted; please refer to the original text for details.
DeleteAcception = 2, 0, 0, "Level {} has been deleted.\s2"
DeleteRejection = 2, 0, 0, "\x1b[91mError: You can only delete the last level in the list.\x1b[37m\s3"

# The "EditHintForEdit" entry informs the user how to edit the level; please refer to the original text for details.
EditHintForEdit = 2, 0, 0, "Selected level {}.\nA text editor window will open.\x1b[93mPlease close the text editor window before continuing.\x1b[37m\nIt is strongly recommended to use a monospaced font for editing.\s3"

# End of "Edit Levels" layout settings.

# Below are "Change Language And Theme" layout settings.

# The "LanguageOrThemeMenu" entry is the menu for selecting language and theme to change.
# The "RetryMenuForLanguageOrTheme" entry appears in the selection menu when the user input does not meet the required conditions; please refer to the original text for details.
# The "LanguageNotAvailable" entry appears when the entered language is not available.
# The "ThemeNotAvailable" entry appears when the entered theme is not available.
LanguageNotAvailable = 2, 0, 0, "\x1b[91mError: The language you entered is not available.\x1b[37m\s3"
ThemeNotAvailable = 2, 0, 0, "\x1b[91mError: The theme you entered is not available. Please check capitalization and full/half-width characters.\x1b[37m\s3"
LanguageOrThemeMenu = 2, 0, 0, "Enter 1 to change language.\nEnter 2 to change theme.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForLanguageOrTheme = 6, 0, 1, "\x1b[91mError: Please enter an integer from {} to {}, or enter \"exit\".\x1b[37m\s3"

# End of "Change Language And Theme" layout settings.

# Below are "Exit The Game" layout settings.

# The "Exit" entry is the last entry displayed before the program exits.
Exit = 6, 0, 0, "Thanks for playing ConsoleMaze!\s3"

# End of "Exit The Game" layout settings.