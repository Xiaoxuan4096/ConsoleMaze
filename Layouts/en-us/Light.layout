# This file supports comments.
# To add a comment, place the '#' symbol at the beginning of the line.

# Each line represents an independent entry.
# Entries follow the format: Key = {StartRow}, {StartCol}, {Depth}, "Value"
# Key is bound to related calls in the program and is not recommended to modify.
# {StartRow} is a size_t value specifying the starting row.
# {StartCol} is a size_t value specifying the starting column.
# {Depth} is an int value specifying the depth of this component.
# "Value" represents the content displayed by the component. The double quotes on both sides are not included in the value.
# To insert double quotes in Value, use the escape character \".
# Similarly, Value supports common escape characters and also supports ANSI escape sequences using \033 and \x1b.

# "{}" appearing in Value will be replaced with actual variable values during output.

# The \033[2J\033[H in the Title field below uses screen clearing to update the theme.
Title = 0, 0, 0, "\x1b[107m\x1b[30m\033[2J\033[HConsoleMaze: A simple console maze game.\n----------------------------------------"
MainMenu = 2, 0, 0, "Enter 1 to start the game.\nEnter 2 to edit levels.\nEnter 3 to change language and theme.\nEnter 4 to exit the game.\n>>> "
RetryIntForMainMenu = 6, 0, 1, "\x1b[31mError: Please enter an integer from {} to {}.\x1b[30m\s3"
SelectLevel = 2, 0, 0, "Currently at level {}. Press Enter to start the current level, or enter a number from {} to {} to select a level.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForSelectLevel = 4, 0, 1, "\x1b[31mError: Please enter an integer from {} to {}, or enter \"exit\".\x1b[30m\s3"
CurrentLevel = 0, 0, 0, "Currently at level {}. Press q to quit the current level.\n---------------------------------------------------------"
WinWithoutRecord = 2, 0, 0, "Congratulations on completing level {}!\nTime: {} seconds {} milliseconds.\s3"
WinWithRecord = 2, 0, 0, "Congratulations on completing level {}!\nTime: {} seconds {} milliseconds.\n\x1b[34mNew record!\x1b[30m\s3"
EditMenu = 2, 0, 0, "There are {} levels available. Enter a number from {} to {} to select a level to edit.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForEditMenu = 4, 0, 1, "\x1b[31mError: Please enter an integer from {} to {}, or enter \"exit\".\x1b[30m\s3"
RetryCreateHint = 6, 0, 0, "\x1b[31mError: Please enter \"create\", press Enter, or enter \"exit\".\x1b[30m\s3"
CreateHint = 2, 0, 0, "Selected level {} does not exist.\nPress Enter or enter \"create\" to create and edit this level.\nEnter \"exit\" to return to the main menu.\n>>> "
CreateAcception = 2, 0, 0, "Level {} has been created."
CreateRejection = 6, 0, 0, "\x1b[31mError: You can only create the level immediately after the last existing level.\x1b[30m\s3"
EditHintForCreate = 3, 0, 0, "Selected level {}.\nA text editor window will open.\x1b[35mPlease close the text editor window before continuing.\x1b[30m\nIt is strongly recommended to use a monospaced font for editing.\s3"
RetryEditOrDeleteHint = 6, 0, 0, "\x1b[31mError: Please enter \"delete\", \"edit\", press Enter, or enter \"exit\".\x1b[30m\s3"
EditOrDeleteHint = 2, 0, 0, "Selected level {}.\nPress Enter or enter \"edit\" to edit this level.\n\x1b[31mEnter \"delete\" to delete this level. Note: This action cannot be undone!\x1b[30m\nEnter \"exit\" to return to the main menu.\n>>> "
DeleteRejection = 2, 0, 0, "\x1b[31mError: You can only delete the last level in the list.\x1b[30m\s3"
DeleteAcception = 2, 0, 0, "Level {} has been deleted.\s2"
EditHintForEdit = 2, 0, 0, "Selected level {}.\nA text editor window will open.\x1b[35mPlease close the text editor window before continuing.\x1b[30m\nIt is strongly recommended to use a monospaced font for editing.\s3"
LanguageNotAvailable = 2, 0, 0, "\x1b[31mError: The language you entered is not available.\x1b[30m\s3"
ThemeNotAvailable = 2, 0, 0, "\x1b[31mError: The theme you entered is not available. Please check capitalization and full/half-width characters.\x1b[30m\s3"
LanguageOrThemeMenu = 2, 0, 0, "Enter 1 to change language.\nEnter 2 to change theme.\nEnter \"exit\" to return to the main menu.\n>>> "
RetryMenuForLanguageOrTheme = 6, 0, 1, "\x1b[31mError: Please enter an integer from {} to {}, or enter \"exit\".\x1b[30m\s3"
Exit = 6, 0, 0, "Thanks for playing ConsoleMaze!\s3"