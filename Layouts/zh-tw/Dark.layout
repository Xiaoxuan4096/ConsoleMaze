RetryMenuForLanguageOrTheme = 6, 0, 1, "\x1b[91m錯誤：請輸入從 {} 到 {} 內的一個整數，或者輸入 exit。\x1b[37m\s3"
Exit = 6, 0, 0, "感謝遊玩 ConsoleMaze！\s3"